      "./src/*.ts",
      "./src/*.tsx",
      "./src/*/index.ts",
      "./src/*/index.tsx"
    ]
  },
  "scripts": {
    "dev": "react-router dev",
    "build": "react-router typegen && tsc --noEmit --checkers 4 && react-router build",
    "lint": "oxlint .",
    "check-types": "tsc --noEmit --checkers 4",
    "format": "oxfmt --config ../../oxfmt.json .",
    "ts:clean": "tsc --build --clean",
    "preview": "react-router build && vite preview",
    "deploy": "react-router build && wrangler deploy",
    "upload": "react-router build && wrangler deploy --dry-run",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts && react-router typegen",
    "test": "vitest run",
    "test:watch": "vitest",
    "typegen": "react-router typegen"
  },
