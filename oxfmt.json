{
  // oxfmt also honours .gitignore, so build output and caches are already excluded. These are the
  // paths it would otherwise format: tracked files we do not own or do not want reformatted.
  "ignorePatterns": [
    // Vendored third-party skill docs — not ours to reformat (433 findings if included).
    ".agents/**",
    // Generated by the package manager.
    "pnpm-lock.yaml",
    // Wrangler rewrites these wholesale on every `cf-typegen` (~28k lines of runtime types), so
    // formatting them only produces churn that the next regeneration undoes. Hand-written ambient
    // files such as src/vite-env.d.ts are still formatted.
    "**/cloudflare-env.d.ts"
  ],
  "printWidth": 120,
  "semi": true,
  "trailingComma": "all",
  "singleQuote": true,
  "quoteProps": "consistent",
  "jsxSingleQuote": false,
  "sortTailwindcss": {
    "stylesheet": "./apps/gw2w2w/src/globals.css",
    "functions": ["clsx", "cn"]
  },
  "sortImports": {
    "customGroups": [
      { "groupName": "type-repo", "elementNamePattern": ["@repo/**"], "modifiers": ["type"] },
      { "groupName": "repo", "elementNamePattern": ["@repo/**"] }
    ],
    "groups": [
      "builtin",
      "type-external",
      { "newlinesBetween": false },
      "external",
      "type-repo",
      { "newlinesBetween": false },
      "repo",
      ["type-internal", "type-subpath"],
      { "newlinesBetween": false },
      ["internal", "subpath"],
      ["type-parent", "type-sibling", "type-index"],
      { "newlinesBetween": false },
      ["parent", "sibling", "index"],
      "style",
      "unknown"
    ]
  }
}
